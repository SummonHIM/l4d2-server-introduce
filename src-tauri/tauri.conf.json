{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SummonL4D2-Server-Launcher",
  "version": "2.0.1",
  "identifier": "top.summonhim.l4d2-server-introduce",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SummonL4D2-Server-Launcher",
        "width": 480,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMzRDNkRBRjQyM0YwNDUKUldSRjhDUDAyc1kwcnVCOUpnd3hIUkVEU2l5TXRlRm1Uc0NQWFZMQjhZa2ZJRVlkaXk5NGpaSWMK",
      "endpoints": [
        "https://github.com/SummonHIM/l4d2-server-introduce/releases/latest/download/latest.json"
      ]
    }
  }
}
